{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "EDITING.md",
      "CNAME"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/legacy",
        "destination": "https://script.google.com/a/macros/dallasisd.org/s/AKfycbxPeUpKgFZnH46aIJKv9Nj6fSkiOxxKqP0yOIxz2b4p3YwDeJ-bxqHnZhEaNKLiUXU/exec?view=legacy",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/start",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/start/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/katex/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      }
    ]
  }
}